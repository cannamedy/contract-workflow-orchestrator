{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Workflow",
  "type": "object",
  "required": ["version", "project", "mode", "authoritative_sources", "skills", "runner", "policy", "groups"],
  "properties": {
    "version": {"const": "1"},
    "project": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "path": {"type": "string"}}},
    "mode": {"enum": ["gated", "autonomous"]},
    "authoritative_sources": {"type": "array"}, "skills": {"type": "object"},
    "runner": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["mock", "codex_cli"]}, "command": {"type": "string"}, "timeout_seconds": {"type": "integer", "minimum": 1}}},
    "policy": {"type": "object"},
    "groups": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["id", "tasks"], "properties": {
        "id": {"type": "string"},
        "tasks": {"type": "array", "items": {"oneOf": [
          {"type": "string"},
          {"type": "object", "required": ["id"], "properties": {
            "id": {"type": "string"}, "dependencies": {"type": "array", "items": {"type": "string"}},
            "depends_on": {"type": "array", "items": {"type": "string"}},
            "expected_outputs": {"type": "array", "items": {"type": "string"}},
            "allowed_paths": {"type": "array", "items": {"type": "string"}},
            "requirement_ids": {"type": "array", "items": {"type": "string"}},
            "contract_anchors": {"type": "array", "items": {"type": "string"}},
            "engineering_spec_anchors": {"type": "array", "items": {"type": "string"}},
            "machine_contract_refs": {"type": "array", "items": {"type": "string"}},
            "conformance_ids": {"type": "array", "items": {"type": "string"}},
            "implementation_design_refs": {"type": "array", "items": {"type": "string"}},
            "skill_role": {"type": "string"}
          }}
        ]}
      }}
      }
    },
    "hard_stops": {"type": "array", "items": {"type": "string"}},
    "authority": {"type": "object", "properties": {"remote": {"type": "string", "minLength": 1}, "branch": {"type": "string", "minLength": 1}}},
    "authority_remote": {"type": "string", "minLength": 1},
    "authority_branch": {"type": "string", "minLength": 1}
    ,"artifact_pipeline": {
      "oneOf": [
        {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
        {"type": "object", "required": ["artifacts"], "properties": {"artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}}}
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["HUMAN_GUIDE", "ENGINEERING_SPEC", "MACHINE_CONTRACT", "CONFORMANCE_SPEC", "IMPLEMENTATION_DESIGN", "IMPLEMENTATION_PLAN", "PLAN_GRAPH", "TASK_CONTRACT"]},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "boolean"}, "enabled": {"type": "boolean"},
        "skill_role": {"type": "string"}, "review_required": {"type": "boolean"},
        "validator_role": {"type": "string"}, "candidate_path": {"type": "string"},
        "accepted_path": {"type": "string"}, "derived_from": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
