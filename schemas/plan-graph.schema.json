{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CWO Plan Graph Projection",
  "type": "object",
  "required": ["schema_version", "plan_sha256", "graph_sha256", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "plan_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "graph_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "group", "dependencies", "requirement_ids", "contract_anchors", "allowed_paths", "expected_outputs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "group": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "requirement_ids": {"type": "array", "items": {"type": "string", "pattern": "^(REQ|OCS)-[A-Za-z0-9_.-]+$"}},
          "contract_anchors": {"type": "array", "items": {"type": "string"}},
          "allowed_paths": {"type": "array", "items": {"type": "string"}},
          "expected_outputs": {"type": "array", "items": {"type": "string"}},
          "skill_role": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
